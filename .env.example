# API Keys — copy this to .env.local and fill in
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Index Alpha — broker summary + foreign flow real IDX (daftar gratis di indexalpha.id)
# Paket gratis 5 request/hari; tanpa key, bandarologi memakai Arjum lalu proxy Yahoo
INDEXALPHA_API_KEY=your_indexalpha_api_key_here
# Opsional: override base URL bila provider berganti domain
# ARJUM_BASE_URL=https://stock.arjum.com
# INDEXALPHA_BASE_URL=https://api.indexalpha.id
